{
	"name": "@mad-c/slides",
	"version": "1.0.0",
	"description": "Web Components based slides",
	"main": "src/index.js",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint:js": "oxlint --fix",
		"lint": "npm run typecheck && npm run lint:js",
		"format": "dprint fmt",
		"version": "npm version --sign-git-tag --message \"chore: update package version\"",
		"postversion": "changelog --output \"docs/changelog\" --push --create-release",
		"update": "update",
		"browsers": "pnpm dlx playwright install chromium",
		"test": "vitest"
	},
	"keywords": [
		"slides",
		"presentation"
	],
	"author": {
		"name": "madcampos",
		"url": "https://madcampos.dev/"
	},
	"license": "LGPL-3",
	"homepage": "https://github.com/madcampos/mad-slides#readme",
	"bugs": {
		"url": "https://github.com/madcampos/mad-slides/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/madcampos/mad-slides.git"
	},
	"funding": [
		{
			"type": "Buy Me a Coffee",
			"url": "https://buymeacoffee.com/madcampos"
		},
		{
			"type": "Ko-Fi",
			"url": "https://ko-fi.com/madcampos"
		}
	],
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.4.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.4.0",
			"onFail": "error"
		}
	},
	"type": "module",
	"devDependencies": {
		"@mad-c/config": "^4.2.0",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"dprint": "^0.57.4",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typed-query-selector": "^2.12.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
